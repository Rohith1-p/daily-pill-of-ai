---
// Gradient seam that fades the light page into the navy workbench.
---

<div class="seam" aria-hidden="true">
  <div class="seam-fog seam-fog-a"></div>
  <div class="seam-fog seam-fog-b"></div>
</div>

<style>
  .seam {
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      #e5e8ed 12%,
      #c8cfd9 26%,
      #9eabba 41%,
      #718097 56%,
      #485b77 71%,
      #293e5f 86%,
      var(--navy-light) 100%
    );
    height: 184px;
    margin-top: 44px;
    position: relative;
    overflow: hidden;
  }
  .seam-fog {
    background: var(--bg);
    pointer-events: none;
    border-radius: 50%;
    animation: fog-drift 18s ease-in-out infinite alternate;
    position: absolute;
  }
  .seam-fog-a {
    width: 380px;
    height: 160px;
    left: 6%;
    top: 30%;
    opacity: 0.35;
  }
  .seam-fog-b {
    width: 300px;
    height: 130px;
    right: 10%;
    top: 55%;
    opacity: 0.25;
    animation-delay: -9s;
  }
  @media (width <= 640px) {
    .seam {
      height: 164px;
      margin-top: 28px;
    }
  }
</style>
